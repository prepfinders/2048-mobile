# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
web-build/
expo-env.d.ts

# Keep the sideload APKs in dist/; ignore other export output
dist/*
!dist/2048.apk
!dist/2048-native-android.apk

# Native build intermediates (the android/ and ios/ projects themselves are committed)
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
!**/debug.keystore

android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties
android/captures/
android/.idea/
android/*.iml
android/app/*.iml

ios/Pods/
ios/build/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/DerivedData/
**/*.xcuserstate

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# tests
coverage/
